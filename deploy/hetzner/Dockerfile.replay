FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/replay-service/package.json apps/replay-service/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/solver-sdk/package.json packages/solver-sdk/package.json
COPY packages/solvers/package.json packages/solvers/package.json
RUN --mount=type=cache,id=cobia-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --filter @cobia/replay-service... --frozen-lockfile

COPY apps/replay-service apps/replay-service
COPY apps/web apps/web
COPY packages packages
RUN ln -s ../replay-service/node_modules apps/web/node_modules

ENV NODE_ENV=production \
  PORT=3001 \
  ANVIL_BIN=/app/apps/replay-service/node_modules/.bin/anvil
USER node
EXPOSE 3001
CMD ["apps/replay-service/node_modules/.bin/tsx", "apps/replay-service/src/index.ts"]
