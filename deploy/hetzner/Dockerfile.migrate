FROM node:24-alpine

RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY deploy/hetzner/migrate/package.json deploy/hetzner/migrate/package.json
RUN --mount=type=cache,id=cobia-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --filter @cobia/migrate --prod --frozen-lockfile \
  && rm -rf /root/.cache/node /root/.cache/pnpm

COPY apps/web/drizzle apps/web/drizzle
COPY deploy/hetzner/migrate/index.mjs deploy/hetzner/migrate/index.mjs
USER node
CMD ["node", "deploy/hetzner/migrate/index.mjs"]
