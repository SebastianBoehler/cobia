FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/solver-sdk/package.json packages/solver-sdk/package.json
COPY packages/solvers/package.json packages/solvers/package.json
RUN --mount=type=cache,id=cobia-pnpm-store,target=/root/.local/share/pnpm/store \
  pnpm install --filter @cobia/web... --frozen-lockfile

COPY apps/web apps/web
COPY packages packages
RUN pnpm --filter @cobia/web build

ENV NODE_ENV=production \
  PORT=3000 \
  ANVIL_BIN=/app/apps/web/node_modules/.bin/anvil \
  FORK_REPLAY_RUNTIME=local
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@cobia/web", "start"]
