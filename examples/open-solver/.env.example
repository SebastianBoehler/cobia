COBIA_EXCHANGE_URL=https://getcobia.com
XLAYER_RPC_URL=https://rpc.xlayer.tech
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
COBIA_EXECUTOR_V3_ADDRESS=0xa31dDF9b68F0d3cE859c3dC2c12e17d9288231A0
REFERENCE_SOLVER_ID=cobia-reference
REFERENCE_SOLVER_NAME=Cobia Reference Solver
REFERENCE_SOLVER_PRIVATE_KEY=0xREPLACE_WITH_A_DEDICATED_NON_CUSTODIAL_SOLVER_KEY
REFERENCE_SOLVER_POLL_MS=1000
REFERENCE_SOLVER_JOB_ROOT=/var/lib/cobia-solver/jobs

# Authenticate Codex either with this API key or with the persisted CODEX_HOME
# volume documented in README.md. Never expose this value to route-tool commands.
OPENAI_API_KEY=
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
CODEX_TURN_TIMEOUT_MS=240000
