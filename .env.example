# PostgreSQL connection used by the Cobia web server.
DATABASE_URL=

# OKX signed API credentials. Keep these server-side only.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# OKX MPP server secret and Agentic Wallet payment configuration.
MPPX_SECRET_KEY=
EXECUTION_SESSION_SECRET=
WALLET_AUTH_SECRET=
COBIA_TREASURY=
PAYMENT_REALM=localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Deterministic solver signing key. Keep this server-side only.
DETERMINISTIC_SOLVER_PRIVATE_KEY=

# Bounded OpenAI route selector and its independent signing key.
OPENAI_API_KEY=
OPENAI_SOLVER_MODEL=
AI_SOLVER_PRIVATE_KEY=

# Local recovery key for the generated dev treasury. The app does not read it.
COBIA_DEV_TREASURY_PRIVATE_KEY=

# X Layer mainnet public RPC endpoint.
XLAYER_RPC_URL=https://rpc.xlayer.tech
# Optional dedicated public read endpoint for testnet.getcobia.com (chain 1952).
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon

# Coding-agent sandbox and independently verified Executor V2 programs.
OPENAI_CODING_AGENT_MODEL=
CODING_AGENT_PUBLIC_ORIGIN=
# Use "local" when the web API runs on a VM with the pinned Anvil binary.
FORK_REPLAY_RUNTIME=vercel
ANVIL_BIN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
COBIA_EXECUTOR_V2_ADDRESS=0x554Dd547C797d6A4350D6A2b098350C1ad6aE674
COBIA_EXECUTOR_V2_CODE_HASH=0xe151a94fefb129c1c2ce1529578ce72f15ac1f7417ef9aff389c52cc75ad7640
# Coordinator-only signer. Never expose it to the sandbox or browser.
COBIA_VERIFIER_PRIVATE_KEY=
