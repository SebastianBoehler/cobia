# PostgreSQL connection used by the Cobia web server.
DATABASE_URL=

# OKX signed API credentials. Keep these server-side only.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# OKX MPP server secret and Agentic Wallet payment configuration.
MPPX_SECRET_KEY=
COBIA_TREASURY=
PAYMENT_CHAIN_ID=1952
PAYMENT_ASSET=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c

# OpenAI research solver. Keep this server-side only.
OPENAI_API_KEY=
OPENAI_SOLVER_MODEL=
DETERMINISTIC_SOLVER_PRIVATE_KEY=
AI_SOLVER_PRIVATE_KEY=

# Local recovery key for the generated dev treasury. The app does not read it.
COBIA_DEV_TREASURY_PRIVATE_KEY=

# X Layer public RPC endpoints.
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
