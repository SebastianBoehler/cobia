{
  "name": "@cobia/promo-remotion",
  "version": "0.1.0",
  "description": "Short proof-first promotional clips for Cobia",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "build": "remotion bundle",
    "dev": "remotion studio --no-open",
    "lint": "eslint src && tsc --noEmit",
    "render:clean-prompt": "remotion render Cobia-Clean-Prompt output/cobia-clean-prompt.mp4",
    "render:clean-prompt:x": "remotion render Cobia-Clean-Prompt-X output/cobia-clean-prompt-x-16x9.mp4",
    "render:bouncy-prompt:x": "remotion render Cobia-Bouncy-Prompt-X output/cobia-bouncy-prompt-x-16x9.mp4",
    "render:tag-picker:x": "remotion render Cobia-Tag-Picker-X output/cobia-tag-picker-x-16x9.mp4",
    "render:token-evidence:x": "remotion render Cobia-Token-Evidence-X output/cobia-token-evidence-x-16x9.mp4",
    "render:landed-proof:x": "remotion render Cobia-Landed-Program-Proof-X output/cobia-landed-program-proof-x-16x9.mp4",
    "render:launch-analytics:x": "remotion render Cobia-Launch-Analytics-X output/cobia-launch-analytics-x-16x9.mp4",
    "render:wallet-review:hero": "remotion render Cobia-Wallet-Review-Hero-X output/cobia-wallet-review-hero-x-16x9.mp4",
    "render:wallet-review:no-blank-cheque": "remotion render Cobia-Wallet-No-Blank-Cheque-X output/cobia-wallet-no-blank-cheque-x-16x9.mp4",
    "render:wallet-review:decision-gate": "remotion render Cobia-Wallet-Decision-Gate-X output/cobia-wallet-decision-gate-x-16x9.mp4",
    "render:launch-native:x": "remotion render Cobia-Launch-Native-X output/cobia-launch-native-x-16x9.mp4",
    "render:launch-no-blank-cheque:x": "remotion render Cobia-Launch-No-Blank-Cheque-X output/cobia-launch-no-blank-cheque-x-16x9.mp4",
    "render:launch-proof:x": "remotion render Cobia-Launch-Proof-X output/cobia-launch-proof-x-16x9.mp4",
    "render:launch-variants": "pnpm render:launch-native:x && pnpm render:launch-no-blank-cheque:x && pnpm render:launch-proof:x",
    "render:solver:better-route": "remotion render Cobia-Solver-Better-Route-X output/cobia-solver-better-route-x-16x9.mp4",
    "render:solver:no-keys": "remotion render Cobia-Solver-No-Keys-X output/cobia-solver-no-keys-x-16x9.mp4",
    "render:solver:reputation": "remotion render Cobia-Solver-Reputation-X output/cobia-solver-reputation-x-16x9.mp4",
    "render:solver-variants": "pnpm render:solver:better-route && pnpm render:solver:no-keys && pnpm render:solver:reputation",
    "render:prompt": "remotion render Cobia-Prompt-Tags-16x9 output/cobia-prompt-tags-16x9.mp4",
    "render:prompt:vertical": "remotion render Cobia-Prompt-Tags-9x16 output/cobia-prompt-tags-9x16.mp4",
    "render:reveal": "remotion render Cobia-Intent-UI-Reveal output/cobia-intent-ui-reveal.mp4",
    "render:verify": "remotion render Cobia-Verify-Flow-Square output/cobia-verify-flow-square.mp4",
    "render:all": "pnpm render:prompt && pnpm render:prompt:vertical && pnpm render:reveal && pnpm render:verify"
  },
  "dependencies": {
    "@remotion/cli": "4.0.514",
    "@remotion/google-fonts": "4.0.514",
    "@remotion/media": "4.0.514",
    "@remotion/rough-notation": "4.0.514",
    "@remotion/transitions": "4.0.514",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.514",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.514",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.7.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
