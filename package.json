{
  "name": "cobia",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @cobia/web dev",
    "contracts:test": "scripts/forge.sh test",
    "executor:plan": "tsx apps/web/scripts/prepare-agent-executor-deployment.ts",
    "executor:v3:plan": "tsx apps/web/scripts/prepare-agent-executor-v3-deployment.ts",
    "executor:v3:console": "tsx apps/web/scripts/serve-agent-executor-v3-deployment.ts",
    "executor:v3:verify": "tsx apps/web/scripts/verify-agent-executor-v3-state.ts",
    "executor:v4:plan": "tsx apps/web/scripts/prepare-agent-executor-v4-deployment.ts",
    "executor:v4:console": "tsx apps/web/scripts/serve-agent-executor-v4-deployment.ts",
    "executor:v4:verify": "tsx apps/web/scripts/verify-agent-executor-v4-state.ts",
    "executor:testnet:plan": "tsx apps/web/scripts/prepare-agent-executor-testnet-deployment.ts",
    "executor:testnet:console": "tsx apps/web/scripts/serve-agent-executor-testnet-deployment.ts",
    "executor:testnet:verify": "tsx apps/web/scripts/verify-agent-executor-testnet-deployment.ts",
    "env:dev": "node apps/web/scripts/seed-dev-env.mjs",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
